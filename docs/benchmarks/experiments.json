    {
      "id": "ingest-packing-thread",
      "title": "Packing on the main thread vs in worker threads",
      "question": "Does moving glTF to GLB packing off the main thread make ingest import faster, and what does it cost?",
      "answer": "No: the import is limited by uploads, so worker threads only add about 0.2 s of start-up, 60-115 % more CPU and about 140 MB of memory; their one gain is a calmer event loop.",
      "report": "ingest-import.md",
      "runs": [
