    {
      "id": "reindex-loader-workers",
      "title": "Reindex: loader worker processes",
      "question": "How many DataLoader worker processes does the reindex job need to keep the model busy, and what does each one cost?",
      "answer": "Two: loading in the main process halves steady throughput (104 vs 245 images/s, the model waits 2.5 s for images), one worker almost keeps up and two make the job model-bound; every further worker adds start-up, shutdown and about 3 s of CPU, so 2 is fastest here (4.2 s) while the default stays at 4 for object storage over a network.",
      "report": "reindex.md",
      "runs": [
        "2026-11-13T15-53-56-599Z-reindex-workers-b64-w0-p2.json",
        "2026-11-13T15-54-04-366Z-reindex-workers-b64-w1-p2.json",
