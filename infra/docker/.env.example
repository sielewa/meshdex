# Local development only. Copy to infra/docker/.env (gitignored) and adjust if needed.
# These values never leave your machine; production credentials live in the cloud's secret store.

# Postgres superuser (used only by the init script and for admin work)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres-local
POSTGRES_PORT=5432

# One login role + database per service (database per service)
ASSET_DB_PASSWORD=asset-local
WORKER_DB_PASSWORD=worker-local
ML_DB_PASSWORD=ml-local

# Redpanda (Kafka API) — services on the host connect to localhost:${KAFKA_EXTERNAL_PORT}
KAFKA_EXTERNAL_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8088

# S3 (SeaweedFS) — services on the host use http://localhost:${S3_PORT}
S3_PORT=8333
S3_ACCESS_KEY_ID=meshdex-local
S3_SECRET_ACCESS_KEY=meshdex-local-secret
S3_REGION=us-east-1
S3_BUCKET=meshdex-assets

# Origin allowed by the bucket's CORS rules (the Next.js dev server)
WEB_ORIGIN=http://localhost:3000
