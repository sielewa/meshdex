# asset-service — local development. Copy to apps/asset-service/.env (gitignored).
# Values match infra/docker/.env.example; in Kubernetes they come from this service's ConfigMap/Secret.

# gRPC server
GRPC_URL=0.0.0.0:50051

# PostgreSQL — the service's own database and role (database per service)
DATABASE_URL=postgres://asset:asset-local@localhost:5432/asset
DATABASE_POOL_MAX=10

# Object storage (SeaweedFS locally, AWS S3 in the cloud)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=meshdex-assets
S3_ACCESS_KEY_ID=meshdex-local
S3_SECRET_ACCESS_KEY=meshdex-local-secret
# Path-style URLs (http://host/bucket/key) — required by local S3 implementations.
S3_FORCE_PATH_STYLE=true

# Uploads
UPLOAD_MAX_SIZE_BYTES=536870912
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_URL_TTL_SECONDS=3600

# Downloads: lifetime of presigned GET URLs for original files (15 minutes)
DOWNLOAD_URL_TTL_SECONDS=900

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
