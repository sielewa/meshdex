# web — local development. Copy to apps/web/.env (gitignored).
# In Kubernetes these values come from this service's ConfigMap. Both are read at
# runtime by the server, so one image works in every environment.

# GraphQL endpoint the Next.js server calls (in the cluster: the gateway's Service DNS name).
GATEWAY_INTERNAL_URL=http://localhost:4000/graphql
# GraphQL endpoint browsers call (allowed by the gateway's CORS_ORIGINS).
PUBLIC_GATEWAY_URL=http://localhost:4000/graphql
