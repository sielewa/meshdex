{
  "name": "@meshdex/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "generate": "graphql-codegen && node scripts/collect-benchmark-runs.ts",
    "dev": "pnpm generate && NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "pnpm generate && NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "pnpm generate && next typegen && tsc --noEmit",
    "lint": "pnpm generate && eslint .",
    "test": "pnpm generate && vitest run",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3000"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.106.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "graphql": "16.15.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
