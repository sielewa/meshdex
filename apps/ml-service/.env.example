# ml-service — local development. Copy to apps/ml-service/.env (gitignored).
# Values match infra/docker/.env.example; in Kubernetes they come from this service's ConfigMap/Secret.

# gRPC server (ADR 019): `python -m ml_service serve`
GRPC_URL=0.0.0.0:50052
# Threads running requests; DATABASE_POOL_MAX must be at least this
GRPC_MAX_WORKERS=8
# Requests in progress at once; more are refused with RESOURCE_EXHAUSTED
GRPC_MAX_CONCURRENT_RPCS=32
# Seconds in-flight requests get to finish after SIGTERM
GRPC_SHUTDOWN_GRACE_S=10

# PostgreSQL — the service's own database and role (database per service)
DATABASE_URL=postgres://ml:ml-local@localhost:5432/ml
DATABASE_POOL_MAX=10

# asset-service over gRPC: the reindex job lists the catalogue
ASSET_SERVICE_URL=localhost:50051
# Deadline of one read call, retries included
ASSET_SERVICE_READ_TIMEOUT_MS=2000

# Object storage (SeaweedFS locally, AWS S3 in the cloud): the reindex job reads preview images.
# In AWS leave S3_ENDPOINT and the keys unset (regional endpoint, the pod's IAM role).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=meshdex-assets
S3_ACCESS_KEY_ID=meshdex-local
S3_SECRET_ACCESS_KEY=meshdex-local-secret
# Path-style URLs (http://host/bucket/key) — required by local S3 implementations.
S3_FORCE_PATH_STYLE=true

# CLIP (ADR 018): open_clip architecture + pretrained tag; the tag selects the image preprocessing
# and names the model in stored embeddings. Weights come from a local file and are never
# downloaded at runtime; the path is relative to apps/ml-service (the working directory).
CLIP_ARCHITECTURE=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_CHECKPOINT_PATH=.cache/models/open_clip_ViT-B-32_laion2b_s34b_b79k.safetensors
# cpu | mps (Apple GPU) | cuda
CLIP_DEVICE=cpu

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
