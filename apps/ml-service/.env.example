# ml-service — local development. Copy to apps/ml-service/.env (gitignored).
# Values match infra/docker/.env.example; in Kubernetes they come from this service's ConfigMap/Secret.

# PostgreSQL — the service's own database and role (database per service)
DATABASE_URL=postgres://ml:ml-local@localhost:5432/ml
DATABASE_POOL_MAX=10

# CLIP (ADR 018): open_clip architecture + pretrained tag; the tag selects the image preprocessing
# and names the model in stored embeddings. Weights come from a local file and are never
# downloaded at runtime; the path is relative to apps/ml-service (the working directory).
CLIP_ARCHITECTURE=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_CHECKPOINT_PATH=.cache/models/open_clip_ViT-B-32_laion2b_s34b_b79k.safetensors
# cpu | mps (Apple GPU) | cuda
CLIP_DEVICE=cpu

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
