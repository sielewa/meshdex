# gateway — local development. Copy to apps/gateway/.env (gitignored).
# In Kubernetes these values come from this service's ConfigMap.

# HTTP server (GraphQL at /graphql, health at /health/live and /health/ready)
HTTP_PORT=4000
# Comma-separated browser origins allowed by CORS (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Schema introspection for tooling and codegen; false in public deployments.
GRAPHQL_INTROSPECTION=true

# asset-service gRPC client
ASSET_SERVICE_URL=localhost:50051
# Deadlines per call (grpc-js service config). Writes include S3 multipart calls.
ASSET_SERVICE_READ_TIMEOUT_MS=2000
ASSET_SERVICE_WRITE_TIMEOUT_MS=15000

# Public files (ADR 010, 017): URL = MEDIA_BASE_URL + object key, for keys under public/ only.
# Locally the S3 emulator's bucket path (anonymous read is limited to public/); CloudFront in the cloud.
MEDIA_BASE_URL=http://localhost:8333/meshdex-assets/

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
