# ingest — local development. Copy to apps/ingest/.env (gitignored).
# In Kubernetes these values come from the ingest Job's ConfigMap.

# Poly Haven public API (ADR 013). Requests carry User-Agent meshdex-ingest/<version>.
POLYHAVEN_API_URL=https://api.polyhaven.com

# Local model cache: `fetch` writes it, `import` reads it. Relative to the working directory.
INGEST_CACHE_DIR=.cache/polyhaven

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
